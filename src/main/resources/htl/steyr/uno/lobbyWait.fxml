<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="879.0" prefWidth="1021.0" styleClass="mainPaine" stylesheets="@style/lobbyWaitStyle.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <VBox prefHeight="0.0" prefWidth="705.0" spacing="18" styleClass="centerArea">
            <padding>
                <Insets bottom="18" left="18" right="18" top="18" />
            </padding>

            <children>
                <VBox alignment="CENTER" spacing="8">
                    <children>
                        <Label fx:id="lobbyCodeLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="51.0" styleClass="lobbyCodeLabel" text="Lobby Code:" />
                        <Line endX="200.0" startX="0.0" strokeWidth="2.0" />
                    </children>
                </VBox>

                <BorderPane prefHeight="592.0" prefWidth="669.0" styleClass="playerPanel" VBox.vgrow="ALWAYS">
                    <top>
                        <HBox alignment="CENTER" prefHeight="33.0" prefWidth="667.0" spacing="12" styleClass="playerHeader">
                            <children>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Label styleClass="playerHeaderLabel" text="Spieler" textAlignment="CENTER" />
                                <Pane HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </top>

                    <center>
                        <VBox BorderPane.alignment="CENTER">
                            <children>
                                <ListView fx:id="playerListView" mouseTransparent="true" prefHeight="635.0" prefWidth="667.0" styleClass="playerListView" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </center>
                </BorderPane>

                <HBox alignment="CENTER" prefHeight="87.0" prefWidth="669.0" spacing="24">
                    <children>
                        <Button fx:id="playButton" onAction="#playButtonClicked" prefHeight="49.0" prefWidth="122.0" styleClass="playButton" text="Spielen" />
                        <Button fx:id="leaveLobbyButton" onAction="#leaveLobbyButtonClicked" prefHeight="49.0" prefWidth="172.0" styleClass="leaveButton" text="Lobby verlassen" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <right>
        <VBox prefHeight="850.0" prefWidth="280.0" spacing="10">
            <padding>
                <Insets bottom="18" left="14" right="14" top="18" />
            </padding>

            <children>
                <Label fx:id="AccNameDisplayLabel" maxWidth="1.7976931348623157E308" styleClass="labels" text="Acc Name:">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Label>

                <StackPane fx:id="chatBox" maxHeight="720.0" minHeight="720.0" prefHeight="720.0" styleClass="chatBox" VBox.vgrow="ALWAYS">
                    <children>
                        <ListView fx:id="gameChatListView" prefHeight="700.0" prefWidth="356.0" styleClass="gameChatListView" />
                    </children>
                </StackPane>

                <TextField fx:id="gameChatTextField" onAction="#onSendMassage" promptText="Sende eine Nachricht an deine Freunde..." styleClass="gameChatTextField" />
            </children>
        </VBox>
    </right>

    <left>
        <VBox prefWidth="260.0" spacing="14" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18" left="14" right="14" top="18" />
            </padding>
            <children>
                <Label styleClass="labels" text="Einstellungen:" textFill="WHITE">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Label>

                <!-- Settings Container -->
                <VBox spacing="16" styleClass="playerPanel">
                    <padding>
                        <Insets bottom="16" left="16" right="16" top="16" />
                    </padding>
                    <children>
                        <!-- Spielvariante Sektion -->
                        <VBox spacing="10">
                            <children>
                                <Label styleClass="labels" text="Spielvariante:" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <VBox spacing="8">
                                    <children>
                                        <!-- Startet standardmäßig mit .selectedOption -->
                                        <Button fx:id="unoClassicButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGameVariant" styleClass="leaveButton, selectedOption" text="UNO Classic" />
                                        <Button fx:id="unoDosButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGameVariant" styleClass="leaveButton" text="UNO &quot;Dos&quot;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Line endX="180.0" stroke="rgba(255, 255, 255, 0.1)" strokeWidth="1.0" />

                        <!-- Lobby-Typ Sektion -->
                        <VBox spacing="10">
                            <children>
                                <Label styleClass="labels" text="Lobby-Typ:" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <VBox spacing="8">
                                    <children>
                                        <Button fx:id="openLobbyButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLobbyType" styleClass="leaveButton" text="🌐 Offene Lobby" />
                                        <Button fx:id="onRequestLobbyButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLobbyType" styleClass="handleLobbyType, leaveButton" text="✋ Auf Anfrage" />
                                        <!-- Startet standardmäßig mit .selectedOption -->
                                        <Button fx:id="codeOnlyButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLobbyType" styleClass="leaveButton, selectedOption" text="🔒 Nur Code" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

</BorderPane>